# ---- LumenDB backend configuration (all vars are optional) ----
# Copy to .env and edit. Prefix is LUMEN_.

# Server
LUMEN_HOST=0.0.0.0
LUMEN_PORT=8000
LUMEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL used when generating MCP client config snippets (e.g. your cloudflared domain)
LUMEN_PUBLIC_BASE_URL=http://localhost:8000
# Optional shared secret. Protects /api/* and /mcp (send X-API-Token or Authorization: Bearer)
LUMEN_API_TOKEN=
LUMEN_DOCS_ENABLED=true
LUMEN_DATA_DIR=

# Query safety
LUMEN_ALLOW_WRITE=true
LUMEN_MAX_ROWS=1000
LUMEN_QUERY_TIMEOUT=30

# MCP
LUMEN_MCP_PATH=/mcp
LUMEN_MCP_MAX_ROWS=100

# LLM: any OpenAI-compatible /chat/completions endpoint.
# Leave LUMEN_LLM_BASE_URL empty to use the built-in offline NL2SQL engine (no API key needed).
# OpenAI:         LUMEN_LLM_API_KEY=sk-...       LUMEN_LLM_MODEL=gpt-4o-mini
# DeepSeek:       LUMEN_LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama (local):  LUMEN_LLM_BASE_URL=http://localhost:11434/v1   LUMEN_LLM_MODEL=qwen2.5-coder:7b
LUMEN_LLM_BASE_URL=
LUMEN_LLM_API_KEY=
LUMEN_LLM_MODEL=
LUMEN_LLM_TEMPERATURE=0
LUMEN_LLM_TIMEOUT=90
LUMEN_LLM_MAX_SCHEMA_TABLES=20

# Encrypts saved connection passwords in the local metadata store
LUMEN_SECRET=change-me-to-a-random-string
